; Projeto Godot que carrega masmorras geradas pelo Python (integração opção A).

config_version=5

[application]

config/name="Gerador de Masmorras"
config/description="Gera (pelo Python), desenha e permite explorar masmorras BSP e Digger."
run/main_scene="res://cenas/masmorra.tscn"
config/features=PackedStringArray("4.7")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.1686, 0.1686, 0.2, 1)
